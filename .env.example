MODEL_PROVIDER=mock
API_HOST=127.0.0.1
API_PORT=8000
POSTGRES_USER=relayforge
POSTGRES_DB=relayforge
# scripts/configure.ps1 generates a random local password and matching URL.
POSTGRES_PASSWORD=replace-with-generated-local-secret
DATABASE_URL=postgresql+psycopg://relayforge:replace-with-generated-local-secret@127.0.0.1:5432/relayforge
LANGGRAPH_STRICT_MSGPACK=true
# Optional user-owned JSON gateway; leave MODEL_PROVIDER=mock for no-key local runs.
# MODEL_PROVIDER=remote_json
# MODEL_BASE_URL=https://your-gateway.example/api
# MODEL_NAME=your-model
# MODEL_API_KEY=
